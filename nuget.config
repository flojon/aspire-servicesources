<?xml version="1.0" encoding="utf-8"?>
<!-- Restore resolves from nuget.org alone, which central package management needs stated rather
     than left to the machine: with ManagePackageVersionsCentrally set and more than one source
     configured, restore fails outright with NU1507 instead of choosing one. Without this file a
     clean clone builds or doesn't depending on the developer's user-level NuGet.Config — a single
     private feed added there for some other project is enough to break it — and CI never catches
     that, because a fresh runner has only nuget.org. Every dependency here is public, so there is
     nothing this needs to add.

     packageSourceMapping is cleared as well as packageSources, because <clear /> inside
     <packageSources> does not clear a mapping declared further up: a user-level mapping would
     otherwise confine these packages to whichever source it names, which fails differently and
     less obviously. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
