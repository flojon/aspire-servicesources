<Project>

  <PropertyGroup>
    <!-- Aspire.Hosting.targets defaults this to false, so Aspire's own integration analyzers
         (the ASPIREEXPORT* rules over the [AspireExport] surface consumed by TypeScript
         AppHosts) never run unless a project opts in. Enable it repo-wide: every
         ServiceSources package is an Aspire integration, and forgetting the opt-in in a new
         satellite project is silent — the analyzer simply does not run, and a broken export
         surface is found by `aspire` CLI codegen against a released package instead of at
         build time.

         Repo-wide reaches projects that are not integrations too - the test assemblies and the
         sample AppHost. Those export nothing, which ASPIREEXPORT017 (Aspire 13.5.0 and later)
         reads as an integration that forgot its exports, so each of them sets
         IsAspirePolyglotCompatible=false to say outright that it has none. -->
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>

  <!-- Versioning is lockstep: one release tag mints the same version for every package, and a
       satellite constrains core to the minor it was built against - not to an exact version,
       so core patches still reach consumers on their own (PinCoreDependency in
       Directory.Build.targets). MinVer is repo-wide for the same reason as the analyzer
       switch above, that the failure of omitting it is silent: a project without it packs as
       the SDK default 1.0.0, which release.yml would then push to nuget.org or fail the
       release on. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <!-- Package metadata every package in src/ shares. Only PackageId, Description and
       PackageTags differ per package, so those stay in the csproj. -->
  <PropertyGroup>
    <Authors>Jonas Flodén</Authors>
    <PackageProjectUrl>https://github.com/flojon/aspire-servicesources</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flojon/aspire-servicesources</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Resolved from the repo root, so the path holds regardless of project depth. Inert where
       IsPackable is false - those projects never pack. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The version of the Aspire package family (Aspire.Hosting and the Aspire.Hosting.*
       packages built alongside it) that every project here references. One property rather
       than a version per csproj, for two reasons.

       Those packages ship in lockstep and are only tested that way, so they are treated as a
       matched set - the full history of why is in src/Directory.Packages.props, which reads
       this property for its floors.

       It is also the knob aspire-matrix.yml turns: overriding this on the command line
       (-p:AspireVersion=...) rebuilds the whole repo against another Aspire version, which is
       how a version other than the floor gets exercised at all.

       The condition leaves the value overridable; the default is the floor, since what a
       consumer who pins nothing gets is what the default build should be testing against.

       One member of the family is out of this property's reach: the Aspire.AppHost.Sdk MSBuild
       SDK the sample AppHost loads. An <Sdk> reference is resolved before properties are
       evaluated, so its version cannot be a property and has to be stated in global.json -
       which cannot read a property either. So the floor below and the version in global.json
       are two literals that have to move together by hand, and ci.yml's `verify repo
       invariants` job is what fails when they part. aspire-matrix.yml moves both per leg;
       before it did, this property floated while global.json's version stayed put, and the
       matrix built a mixed-version family (#116). -->
  <PropertyGroup>
    <AspireVersion Condition="'$(AspireVersion)' == ''">13.5.2</AspireVersion>
  </PropertyGroup>

</Project>
