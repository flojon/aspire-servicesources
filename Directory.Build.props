<Project>

  <PropertyGroup>
    <!-- Aspire.Hosting.targets defaults this to false, so Aspire's own integration analyzers
         (the ASPIREEXPORT* rules over the [AspireExport] surface consumed by TypeScript
         AppHosts) never run unless a project opts in. Enable it repo-wide: every
         ServiceSources package is an Aspire integration, and forgetting the opt-in in a new
         satellite project is silent — the analyzer simply does not run, and a broken export
         surface is found by `aspire` CLI codegen against a released package instead of at
         build time.

         Repo-wide reaches projects that are not integrations too - the test assemblies and the
         sample AppHost. Those export nothing, which ASPIREEXPORT017 (Aspire 13.5.0 and later)
         reads as an integration that forgot its exports, so each of them sets
         IsAspirePolyglotCompatible=false to say outright that it has none. -->
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The Aspire package family's version, declared once because these packages are only
         supported as a matched set and have coupled across a friend-assembly boundary before:
         Aspire.Hosting.JavaScript 13.4.6 calls Aspire.Hosting's internal PathNormalizer, which
         Aspire.Hosting 13.5.2 no longer grants it access to, so that pair restores and compiles
         clean and then throws MethodAccessException at run time. One declaration makes such a
         mismatch unrepresentable in this repo's own build.

         It cannot do the same for a consumer, who resolves the two packages from their own
         graph - the satellite ships an MSBuild check for that case; see
         buildTransitive/KoalaSoft.Aspire.Hosting.ServiceSources.JavaScript.targets.

         Overridable, so a build can be pointed at another version without editing any file. -->
    <AspireVersion Condition="'$(AspireVersion)' == ''">13.5.2</AspireVersion>
  </PropertyGroup>

  <!-- Versioning is lockstep: one release tag mints the same version for every package, and a
       satellite constrains core to the minor it was built against - not to an exact version,
       so core patches still reach consumers on their own (PinCoreDependency in
       Directory.Build.targets). MinVer is repo-wide for the same reason as the analyzer
       switch above, that the failure of omitting it is silent: a project without it packs as
       the SDK default 1.0.0, which release.yml would then push to nuget.org or fail the
       release on. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Package metadata every package in src/ shares. Only PackageId, Description and
       PackageTags differ per package, so those stay in the csproj. -->
  <PropertyGroup>
    <Authors>Jonas Flodén</Authors>
    <PackageProjectUrl>https://github.com/flojon/aspire-servicesources</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flojon/aspire-servicesources</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Resolved from the repo root, so the path holds regardless of project depth. Inert where
       IsPackable is false - those projects never pack. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
