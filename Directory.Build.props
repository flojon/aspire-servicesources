<Project>

  <PropertyGroup>
    <!-- Aspire.Hosting.targets defaults this to false, so Aspire's own integration analyzers
         (the ASPIREEXPORT* rules over the [AspireExport] surface consumed by TypeScript
         AppHosts) never run unless a project opts in. Enable it repo-wide: every
         ServiceSources package is an Aspire integration, and forgetting the opt-in in a new
         satellite project is silent — the analyzer simply does not run, and a broken export
         surface is found by `aspire` CLI codegen against a released package instead of at
         build time. -->
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>

  <!--
    Versioning is lockstep: one release tag mints the same version for every package in the
    repo, and a satellite depends on the exact core it was built against (see
    PinCoreDependency in Directory.Build.targets). Aspire itself ships this way - every
    Aspire.Hosting.* package carries one version - and the satellites implement
    ILocalResourceKind, a core extension point that is not yet stable across versions, so
    letting the two drift apart would buy nothing and break combinations nobody tested.

    MinVer therefore lives here rather than per-project, for the same reason as the analyzer
    switch above: omitting it in a new satellite is silent, and the failure is expensive. A
    project without MinVer packs as the SDK default 1.0.0, and release.yml deliberately does
    not pass the "skip duplicate" flag when pushing, so such a package either lands on
    nuget.org as a bogus 1.0.0 or fails the release outright. Repo-wide also keeps the pin
    honest, since it is only correct while every package reads the same tag series.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Package metadata every package in src/ shares. Only PackageId, Description and
       PackageTags differ per package, so those stay in the csproj. -->
  <PropertyGroup>
    <Authors>Jonas Flodén</Authors>
    <PackageProjectUrl>https://github.com/flojon/aspire-servicesources</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flojon/aspire-servicesources</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- $(MSBuildThisFileDirectory) rather than the ../../ these used to carry per project:
       the path is then correct regardless of how deep the project sits. Inert in projects
       that set IsPackable=false, which never run pack. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
