<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shared package metadata, MinVer and the LICENSE/README pack items live in
       Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>KoalaSoft.Aspire.Hosting.ServiceSources</PackageId>
    <Description>Aspire hosting integration for configurable, per-developer service sources — e.g. a git checkout or a Kubernetes cluster.</Description>
    <PackageTags>aspire;dotnet-aspire;service-discovery;apphost;kubernetes;git;microservices;local-development;port-forward</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- The two guest-language hosting packages are compile-time only: PrivateAssets="all" keeps
       them out of this package's nuspec, so an AppHost inherits neither them nor the Aspire
       floors they carry. The kinds reach their types only inside method bodies, so the JIT
       needs the assembly on disk only when a service actually declares kind: javascript/java. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Java" PrivateAssets="all" />
  </ItemGroup>

  <!-- NuGet imports build/$(PackageId).targets into every consuming project, which is what lets
       the floor for the two undeclared references be checked at the consumer's restore. -->
  <ItemGroup>
    <None Include="build\$(PackageId).targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
