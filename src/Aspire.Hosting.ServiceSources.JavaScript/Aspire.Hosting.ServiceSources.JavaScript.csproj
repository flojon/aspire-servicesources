<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shared package metadata, MinVer and the LICENSE/README pack items live in
       Directory.Build.props. The dependency on core is rewritten into a range closed at
       core's next minor by PinCoreDependency in Directory.Build.targets, so a core patch
       resolves without republishing this package. -->
  <PropertyGroup>
    <PackageId>KoalaSoft.Aspire.Hosting.ServiceSources.JavaScript</PackageId>
    <Description>JavaScript support for KoalaSoft.Aspire.Hosting.ServiceSources — runs a "local"-sourced service with kind "javascript" through Aspire.Hosting.JavaScript.</Description>
    <PackageTags>aspire;dotnet-aspire;service-discovery;apphost;javascript;typescript;nodejs;vite;nextjs;bun;local-development</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aspire.Hosting.ServiceSources/Aspire.Hosting.ServiceSources.csproj" />
  </ItemGroup>

  <!-- The consumer-side guard against a mismatched Aspire pair. NuGet imports
       buildTransitive/<PackageId>.targets into the project that consumes this package, so the
       file's name has to stay equal to PackageId - hence the property rather than the literal
       name, which would go stale silently if the package were ever renamed.

       Include, not Update, even though the file sits in the project directory: the SDK's
       default item globs only run in the per-framework inner builds, and pack runs in the
       cross-targeting outer build where they do not - so an Update there matches nothing and
       the file silently never reaches the package. DefaultItemExcludes then keeps the inner
       builds from globbing a second copy of it on top of this one. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);buildTransitive/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive/$(PackageId).targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
