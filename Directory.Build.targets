<Project>

  <!--
    Adds net11.0 to every multi-targeted project when IncludeNet11Preview is set, which is how
    net11-preview.yml compiles and tests against the preview framework itself rather than only
    building the shipped frameworks under a preview SDK.

    Off by default, so the TargetFrameworks that pack and publish read are the shipped three and
    nothing here reaches a released package.

    Lives in .targets rather than .props because it appends to $(TargetFrameworks), which each
    csproj sets in its own body - at .props time, imported above that, there is nothing to
    append to yet.

    Repo-wide rather than a line per csproj so a new project is covered by existing in the
    build at all. The same argument Directory.Build.props makes for
    EnableAspireIntegrationAnalyzers applies here, and more sharply: a project left out is not
    reported, it is simply never compiled against the preview, which reads as a passing check.

    The TargetFrameworks guard keeps this to projects that already multi-target. A project using
    singular TargetFramework, as the sample AppHost does, sets no TargetFrameworks for this to
    append to, and appending a second framework to a single-targeted project would change what
    it builds rather than adding to it.
  -->
  <PropertyGroup>
    <TargetFrameworks Condition="'$(IncludeNet11Preview)' == 'true' and '$(TargetFrameworks)' != ''">$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>

  <!--
    Aspire.Hosting.targets appends the well-known 'polyglot' NuGet tag to $(PackageTags) for an
    integration that has the analyzers on and has not opted out - the tag `aspire add` reads to
    surface a package to non-C# AppHosts, which is the audience the ATS exports exist for.

    It never reached a packed nuspec. obj/*.nuget.g.targets imports Aspire.Hosting.targets only
    inside its per-framework ImportGroups ('$(TargetFramework)' == 'net8.0' and so on), while
    pack generates the nuspec from the cross-targeting outer pass, where $(TargetFramework) is
    empty and that import does not happen. The tag was appended three times, once per inner
    build, and each time to a property no nuspec was ever generated from.

    So do it here, where the outer pass sees it. Same reason as everything else in this file:
    it reads $(PackageTags), which each csproj sets in its own body, so .props is too early.

    The append is plain text, deliberately, and not $([System.String]::Concat(...)) the way
    Aspire writes it. MSBuild escapes the result of a property function so it cannot be re-read
    as a list - semicolons come back as %3B - and $(PackageTags) is an MSBuild list that NuGet
    splits on ';' and rejoins with spaces when it writes the nuspec. Concat therefore produced a
    single opaque literal, and the packed tags came out as the raw 'a;b;c polyglot' instead of
    the 'a b c polyglot' every other package on nuget.org ships. Plain expansion keeps the list
    a list.

    The per-property conditions are Aspire's own space-padded whole-token test, so if a future
    SDK makes that import reach the outer pass the two cannot both append, and an unrelated tag
    merely containing the substring does not suppress this one. The empty case is split out
    rather than trimmed: with no tags to append to, plain expansion would leave a leading space.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'
                            and '$(EnableAspireIntegrationAnalyzers)' == 'true'
                            and '$(IsAspirePolyglotCompatible)' != 'false'">
    <PackageTags Condition="'$(PackageTags)' == ''">polyglot</PackageTags>
    <PackageTags Condition="'$(PackageTags)' != ''
                            and !$([System.String]::Concat(' ', '$(PackageTags)', ' ').Contains(' polyglot '))">$(PackageTags) polyglot</PackageTags>
  </PropertyGroup>

  <!--
    Put the CHANGELOG.md section for the version being packed into PackageReleaseNotes, so a
    breaking change reaches the nuget.org listing rather than only the repo. Hand-maintaining
    the property in the csproj would mean writing every release note twice and noticing when
    the two drift; reading the changelog keeps one source of truth.

    Lives in .targets rather than .props because it reads $(PackageVersion), which MinVer
    computes from the git tag during the build - it does not exist yet at .props time.
  -->

  <PropertyGroup>
    <ChangelogFile Condition="'$(ChangelogFile)' == ''">$(MSBuildThisFileDirectory)CHANGELOG.md</ChangelogFile>
    <ChangelogUrl Condition="'$(ChangelogUrl)' == ''">https://github.com/flojon/aspire-servicesources/blob/main/CHANGELOG.md</ChangelogUrl>
  </PropertyGroup>

  <UsingTask TaskName="ReadChangelogSection"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ChangelogFile ParameterType="System.String" Required="true" />
      <ReleaseVersion ParameterType="System.String" Required="true" />
      <SectionName ParameterType="System.String" Output="true" />
      <Section ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Body of "## [<name>] ...", up to the next "## " heading or the reference-link
        // block Keep a Changelog puts at the end of the file.
        Func<string, string, string> body = (text, name) =>
        {
            var match = Regex.Match(
                text,
                @"^\#\# \[" + Regex.Escape(name) + @"\][^\n]*\n(?<body>.*?)(?=^\#\# |^\[)",
                RegexOptions.Multiline | RegexOptions.Singleline);
            if (!match.Success) return "";

            // "([#62])" is a markdown reference link, and its definition lives at the end of
            // the file, outside the section. NuGet renders release notes as plain text, so
            // unwrap it to "(#62)" rather than shipping a link that resolves to nothing.
            // A cross-repository reference carries a prefix - "[microsoft/aspire#19507]",
            // "[NuGetGallery#6948]" - and needs the same unwrapping. Only a label ending in
            // "#<digits>" is one of these, which leaves "[AspireExport]" and the like alone.
            return Regex.Replace(match.Groups["body"].Value.Trim(), @"\[([^\[\]]*\#\d+)\]", "$1");
        };

        var changelog = File.ReadAllText(ChangelogFile);

        // A tagged release has its own section. The per-commit prereleases preview.yml
        // pushes never do, so they describe what is sitting unreleased on main instead.
        Section = body(changelog, ReleaseVersion);
        SectionName = Section.Length > 0 ? ReleaseVersion : "";

        if (Section.Length == 0 && ReleaseVersion.Contains("-"))
        {
            Section = body(changelog, "Unreleased");
            SectionName = Section.Length > 0 ? "Unreleased" : "";
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SetPackageReleaseNotesFromChangelog"
          AfterTargets="MinVer"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' != 'false' and '$(PackageReleaseNotes)' == '' and Exists('$(ChangelogFile)')">

    <ReadChangelogSection ChangelogFile="$(ChangelogFile)" ReleaseVersion="$(PackageVersion)">
      <Output TaskParameter="SectionName" PropertyName="_ChangelogSectionName" />
      <Output TaskParameter="Section" PropertyName="_ChangelogSection" />
    </ReadChangelogSection>

    <!-- No section for this version and no Unreleased to fall back on: link, rather than
         pack a release carrying no notes at all. -->
    <PropertyGroup Condition="'$(_ChangelogSectionName)' == ''">
      <PackageReleaseNotes>Release notes: $(ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_ChangelogSectionName)' == 'Unreleased'">
      <PackageReleaseNotes>Preview build. Unreleased changes since the last release:

$(_ChangelogSection)

Full changelog: $(ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_ChangelogSectionName)' != '' and '$(_ChangelogSectionName)' != 'Unreleased'">
      <PackageReleaseNotes>$(_ChangelogSection)

Full changelog: $(ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>

    <Message Importance="normal"
             Text="PackageReleaseNotes taken from $(ChangelogFile) section '$(_ChangelogSectionName)'."
             Condition="'$(_ChangelogSectionName)' != ''" />
    <!-- Split by whether the version is a prerelease, because the two cases mean opposite
         things and ci.yml builds with -warnaserror.

         A release version with no section of its own is the mistake this guard exists for:
         a tag was pushed and its notes were never written, and the packages that tag
         publishes would carry a bare link in place of them.

         A prerelease reaching here is the ordinary state of main for a while after a release.
         Closing the changelog renames [Unreleased] to the version that shipped, so until the
         next entry is written there is genuinely nothing unreleased to describe - and every
         build between those two points is a prerelease. Warning on it would fail CI on every
         PR for having nothing to say, so report it and move on. -->
    <Message Importance="normal"
             Text="No '$(PackageVersion)' section in $(ChangelogFile) and nothing unreleased - packing with a link to the changelog."
             Condition="'$(_ChangelogSectionName)' == '' and $(PackageVersion.Contains('-'))" />
    <Warning Text="No '$(PackageVersion)' section in $(ChangelogFile) - packing with a link to the changelog instead of release notes."
             Condition="'$(_ChangelogSectionName)' == '' and !$(PackageVersion.Contains('-'))" />
  </Target>

</Project>
