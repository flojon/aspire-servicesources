<Project>

  <!--
    Adds net11.0 to every multi-targeted project when IncludeNet11Preview is set, which is how
    net11-preview.yml compiles and tests against the preview framework itself rather than only
    building the shipped frameworks under a preview SDK.

    Off by default, so the TargetFrameworks that pack and publish read are the shipped three and
    nothing here reaches a released package.

    Lives in .targets rather than .props because it appends to $(TargetFrameworks), which each
    csproj sets in its own body - at .props time, imported above that, there is nothing to
    append to yet.

    Repo-wide rather than a line per csproj so a new satellite is covered by existing in the
    build at all. The same argument Directory.Build.props makes for
    EnableAspireIntegrationAnalyzers applies here, and more sharply: a project left out is not
    reported, it is simply never compiled against the preview, which reads as a passing check.

    The TargetFrameworks guard keeps this to projects that already multi-target. A project using
    singular TargetFramework, as the sample AppHost does, sets no TargetFrameworks for this to
    append to, and appending a second framework to a single-targeted project would change what
    it builds rather than adding to it.
  -->
  <PropertyGroup>
    <TargetFrameworks Condition="'$(IncludeNet11Preview)' == 'true' and '$(TargetFrameworks)' != ''">$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>

  <!--
    Aspire.Hosting.targets appends the well-known 'polyglot' NuGet tag to $(PackageTags) for an
    integration that has the analyzers on and has not opted out - the tag `aspire add` reads to
    surface a package to non-C# AppHosts, which is the audience the ATS exports exist for.

    It never reached a packed nuspec. obj/*.nuget.g.targets imports Aspire.Hosting.targets only
    inside its per-framework ImportGroups ('$(TargetFramework)' == 'net8.0' and so on), while
    pack generates the nuspec from the cross-targeting outer pass, where $(TargetFramework) is
    empty and that import does not happen. The tag was appended three times, once per inner
    build, and each time to a property no nuspec was ever generated from.

    So do it here, where the outer pass sees it. Same reason as everything else in this file:
    it reads $(PackageTags), which each csproj sets in its own body, so .props is too early.

    The append is plain text, deliberately, and not $([System.String]::Concat(...)) the way
    Aspire writes it. MSBuild escapes the result of a property function so it cannot be re-read
    as a list - semicolons come back as %3B - and $(PackageTags) is an MSBuild list that NuGet
    splits on ';' and rejoins with spaces when it writes the nuspec. Concat therefore produced a
    single opaque literal, and the packed tags came out as the raw 'a;b;c polyglot' instead of
    the 'a b c polyglot' every other package on nuget.org ships. Plain expansion keeps the list
    a list.

    The per-property conditions are Aspire's own space-padded whole-token test, so if a future
    SDK makes that import reach the outer pass the two cannot both append, and an unrelated tag
    merely containing the substring does not suppress this one. The empty case is split out
    rather than trimmed: with no tags to append to, plain expansion would leave a leading space.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'
                            and '$(EnableAspireIntegrationAnalyzers)' == 'true'
                            and '$(IsAspirePolyglotCompatible)' != 'false'">
    <PackageTags Condition="'$(PackageTags)' == ''">polyglot</PackageTags>
    <PackageTags Condition="'$(PackageTags)' != ''
                            and !$([System.String]::Concat(' ', '$(PackageTags)', ' ').Contains(' polyglot '))">$(PackageTags) polyglot</PackageTags>
  </PropertyGroup>

  <!--
    Put the CHANGELOG.md section for the version being packed into PackageReleaseNotes, so a
    breaking change reaches the nuget.org listing rather than only the repo. Hand-maintaining
    the property in the csproj would mean writing every release note twice and noticing when
    the two drift; reading the changelog keeps one source of truth.

    Lives in .targets rather than .props because it reads $(PackageVersion), which MinVer
    computes from the git tag during the build - it does not exist yet at .props time.

    Between releases the entries are not in CHANGELOG.md at all: each PR writes one to a file of
    its own under changelog.d/, and they are folded into the file only when the release is cut
    (see changelog.d/README.md). So the [Unreleased] fallback below reads that directory too -
    without it every per-commit prerelease would pack no notes for the whole gap between one
    release and the next.
  -->

  <PropertyGroup>
    <ChangelogFile Condition="'$(ChangelogFile)' == ''">$(MSBuildThisFileDirectory)CHANGELOG.md</ChangelogFile>
    <ChangelogFragmentDir Condition="'$(ChangelogFragmentDir)' == ''">$(MSBuildThisFileDirectory)changelog.d</ChangelogFragmentDir>
    <ChangelogUrl Condition="'$(ChangelogUrl)' == ''">https://github.com/flojon/aspire-servicesources/blob/main/CHANGELOG.md</ChangelogUrl>
  </PropertyGroup>

  <UsingTask TaskName="ReadChangelogSection"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ChangelogFile ParameterType="System.String" Required="true" />
      <FragmentDir ParameterType="System.String" />
      <ReleaseVersion ParameterType="System.String" Required="true" />
      <SectionName ParameterType="System.String" Output="true" />
      <Section ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Body of "## [<name>] ...", up to the next "## " heading or the reference-link
        // block Keep a Changelog puts at the end of the file.
        Func<string, string, string> body = (text, name) =>
        {
            var match = Regex.Match(
                text,
                @"^\#\# \[" + Regex.Escape(name) + @"\][^\n]*\n(?<body>.*?)(?=^\#\# |^\[)",
                RegexOptions.Multiline | RegexOptions.Singleline);
            return match.Success ? match.Groups["body"].Value.Trim() : "";
        };

        // Both link styles the entries use render as a bare "(#62)". A fragment writes its
        // links inline, "([#62](https://...))", and the changelog writes them as references,
        // "([#62])", whose definitions live at the end of the file and outside the section.
        // NuGet renders release notes as plain text, so neither survives as a link: unwrap
        // both rather than shipping markup that resolves to nothing.
        Func<string, string> plain = text =>
        {
            text = Regex.Replace(text, @"\[(\#\d+)\]\([^()]*\)", "$1");
            return Regex.Replace(text, @"\[(\#\d+)\]", "$1");
        };

        // The changelog.d/ fragments, grouped under their headings in the order the changelog
        // uses. Mirrors what scripts/collect-changelog.sh will write at release time, closely
        // enough for release notes - the script is what produces the file itself.
        Func<string> fragments = () =>
        {
            if (string.IsNullOrEmpty(FragmentDir) || !Directory.Exists(FragmentDir)) return "";

            var rendered = new StringBuilder();
            foreach (var section in new[] { "Breaking", "Added", "Changed", "Fixed", "Documentation" })
            {
                var suffix = "-" + section.ToLowerInvariant() + ".md";

                // The pattern is matched again as a case-sensitive regex because a Windows
                // filesystem would let "*-added.md" match "12-Added.md", which is not a name
                // the convention allows and not one the release script would pick up.
                var names = Directory.GetFiles(FragmentDir, "*" + suffix)
                    .Select(Path.GetFileName)
                    .Where(name => Regex.IsMatch(name, @"^\d+" + Regex.Escape(suffix) + "$"))
                    .OrderBy(name => int.Parse(name.Split('-')[0]))
                    .ToList();
                if (names.Count == 0) continue;

                rendered.Append("### ").Append(section).Append("\n\n");
                foreach (var name in names)
                {
                    rendered.Append(File.ReadAllText(Path.Combine(FragmentDir, name)).Trim());
                    rendered.Append("\n\n");
                }
            }
            return rendered.ToString().Trim();
        };

        var changelog = File.ReadAllText(ChangelogFile);

        // A tagged release has its own section, folded in when the release was cut. The
        // per-commit prereleases preview.yml pushes never do, so they describe what is sitting
        // unreleased on main instead: the [Unreleased] section, plus the fragments waiting to
        // be folded into it. Both, because a hand-written entry can still be sitting in the
        // file - a section present in both then appears twice, which is untidy in a preview
        // listing and better than dropping half the notes.
        Section = plain(body(changelog, ReleaseVersion));
        SectionName = Section.Length > 0 ? ReleaseVersion : "";

        if (Section.Length == 0 && ReleaseVersion.Contains("-"))
        {
            var pending = new List<string>();
            var unreleased = body(changelog, "Unreleased");
            if (unreleased.Length > 0) pending.Add(unreleased);

            var waiting = fragments();
            if (waiting.Length > 0) pending.Add(waiting);

            Section = plain(string.Join("\n\n", pending));
            SectionName = Section.Length > 0 ? "Unreleased" : "";
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SetPackageReleaseNotesFromChangelog"
          AfterTargets="MinVer"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' != 'false' and '$(PackageReleaseNotes)' == '' and Exists('$(ChangelogFile)')">

    <ReadChangelogSection ChangelogFile="$(ChangelogFile)"
                          FragmentDir="$(ChangelogFragmentDir)"
                          ReleaseVersion="$(PackageVersion)">
      <Output TaskParameter="SectionName" PropertyName="_ChangelogSectionName" />
      <Output TaskParameter="Section" PropertyName="_ChangelogSection" />
    </ReadChangelogSection>

    <!-- No section for this version and no Unreleased to fall back on: link, rather than
         pack a release carrying no notes at all. -->
    <PropertyGroup Condition="'$(_ChangelogSectionName)' == ''">
      <PackageReleaseNotes>Release notes: $(ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_ChangelogSectionName)' == 'Unreleased'">
      <PackageReleaseNotes>Preview build. Unreleased changes since the last release:

$(_ChangelogSection)

Full changelog: $(ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_ChangelogSectionName)' != '' and '$(_ChangelogSectionName)' != 'Unreleased'">
      <PackageReleaseNotes>$(_ChangelogSection)

Full changelog: $(ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>

    <Message Importance="normal"
             Text="PackageReleaseNotes taken from $(ChangelogFile) section '$(_ChangelogSectionName)'."
             Condition="'$(_ChangelogSectionName)' != ''" />
    <!-- Split by whether the version is a prerelease, because the two cases mean opposite
         things and ci.yml builds with -warnaserror.

         A release version with no section of its own is the mistake this guard exists for:
         a tag was pushed and its notes were never written, and the packages that tag
         publishes would carry a bare link in place of them.

         A prerelease reaching here is the ordinary state of main for a while after a release.
         Closing the changelog renames [Unreleased] to the version that shipped, so until the
         next entry is written there is genuinely nothing unreleased to describe - and every
         build between those two points is a prerelease. Warning on it would fail CI on every
         PR for having nothing to say, so report it and move on. -->
    <Message Importance="normal"
             Text="No '$(PackageVersion)' section in $(ChangelogFile) and nothing unreleased - packing with a link to the changelog."
             Condition="'$(_ChangelogSectionName)' == '' and $(PackageVersion.Contains('-'))" />
    <Warning Text="No '$(PackageVersion)' section in $(ChangelogFile) - packing with a link to the changelog instead of release notes."
             Condition="'$(_ChangelogSectionName)' == '' and !$(PackageVersion.Contains('-'))" />
  </Target>

  <!--
    A ProjectReference packs as a version *floor*, so a satellite would declare "core >= X"
    and NuGet could satisfy it with any later core. A satellite implements core's
    ILocalResourceKind, so a mismatched pair throws MissingMethodException/TypeLoadException
    at run time rather than failing at restore. This rewrites the dependency to a range that
    is open at the patch level but closed at the next minor: [X, major.(minor+1).0).

    The minor is the boundary because that is where this project's changelog policy allows an
    interface to break while the version is below 1.0. A core patch still reaches consumers
    without republishing every satellite, which an exact pin would forbid.

    The upper bound carries a -0 suffix on prerelease builds only, and the difference is not
    cosmetic - it is which feed the package is going to.

    A bare major.(minor+1).0 bound admits every major.(minor+1).0-* version, because a
    prerelease sorts below the release it precedes. That is not theoretical: preview.yml
    publishes 0.x.y-alpha.0.N builds of all three packages, and a satellite preview's floor is
    its own prerelease version, which turns prerelease resolution on for the whole range. So a
    0.2.x satellite preview would happily take core 0.3.0-alpha.0.N - the next-minor pairing
    this range exists to forbid. -0 is the lowest prerelease label there is, so it closes the
    bound below all of them.

    nuget.org rejects that bound outright. Its gallery validation fails the *push* with "The
    package manifest contains an invalid Version: '0.4.0-0'", though the NuGet client, pack,
    and GitHub Packages all accept it - so a satellite carrying it packs and restores clean
    everywhere except the one feed releases go to (NuGetGallery#6948, open and unresolved).
    That is exactly how it got here: 0.3.0 tagged, core published, both satellites rejected at
    the push step, because nothing before that step had ever packed a *stable* version.

    A stable build therefore gets the plain bound, and loses nothing by it: nuget.org only
    ever holds stable versions of these packages - every prerelease goes to GitHub Packages -
    so there is no major.(minor+1).0-* on that feed for the plain bound to let in. Each feed
    gets the tightest bound it will accept.

    Both bounds come from %(ProjectVersion) - the version NuGet computed for the referenced
    project - rather than this project's own $(PackageVersion), so the range describes core
    even if the two ever stop resolving to the same version. Runs here rather than in
    Directory.Build.props because _GetProjectReferenceVersions is what populates
    %(ProjectVersion), the same reason as the changelog target above.
  -->
  <Target Name="PinCoreDependency" AfterTargets="_GetProjectReferenceVersions">
    <!-- Regex::Replace returns its input unchanged when the pattern does not match, so a
         %(ProjectVersion) that is not major.minor.* would survive the split below and reach
         MSBuild::Add as a non-numeric string, failing the build with an MSB4184 evaluation
         error that names only the Add call. Check the shape first and say which reference
         and which version could not be turned into a range.

         The Identity test is what keeps this quiet for core, which has no in-repo project
         references at all: a task batched over an empty item list still runs once, with
         every metadata reference expanding to the empty string. -->
    <Error Condition="'%(_ProjectReferencesWithVersions.Identity)' != '' AND !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_ProjectReferencesWithVersions.ProjectVersion)', '^[0-9]+\.[0-9]+\.'))"
           Text="PinCoreDependency cannot build a version range for %(_ProjectReferencesWithVersions.Identity): its resolved package version '%(_ProjectReferencesWithVersions.ProjectVersion)' is not major.minor.patch." />
    <!-- Split first: the range needs minor+1, and MSBuild cannot do arithmetic on a
         version string without pulling the components out one at a time. -->
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <_Major>$([System.Text.RegularExpressions.Regex]::Replace('%(ProjectVersion)', '^([0-9]+)\..*$', '$1'))</_Major>
        <_Minor>$([System.Text.RegularExpressions.Regex]::Replace('%(ProjectVersion)', '^[0-9]+\.([0-9]+).*$', '$1'))</_Minor>
        <!-- A '-' anywhere in the version is a prerelease label, which is what says this build
             is bound for the preview feed rather than nuget.org. Computed here, in the same
             pass as the numeric split, so the assignment below reads one piece of metadata
             instead of re-testing the version it is in the middle of overwriting.

             Declared empty first rather than only under the condition: referencing metadata
             that some item in the list does not define at all is MSB4096, so the stable case
             has to be an explicit empty value, not an absent one. -->
        <_UpperBoundSuffix></_UpperBoundSuffix>
        <_UpperBoundSuffix Condition="$([System.String]::Copy('%(ProjectVersion)').Contains('-'))">-0</_UpperBoundSuffix>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
    <!-- Every in-repo project reference is to an in-repo package released from the same tag,
         so this deliberately matches on all of them rather than on core's project filename,
         which a rename would silently stop matching. -->
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <ProjectVersion>[%(ProjectVersion), %(_Major).$([MSBuild]::Add('%(_Minor)', 1)).0%(_UpperBoundSuffix))</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
