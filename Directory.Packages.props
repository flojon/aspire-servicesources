<Project>

  <!--
    Central Package Management: versions live here, PackageReference in the projects carries
    only the id. Without it the same version is repeated once per project - the xunit set is
    identical across all three test projects today, and every satellite added for #46-#50
    repeats it again.

    This file holds the versions for projects whose dependencies constrain nobody: the tests
    and the sample. The published packages have their own file next to them, because a
    version there is a floor consumers inherit and the two roles want opposite policies.
    See src/Directory.Packages.props.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Off deliberately, and it must stay off while this repository publishes packages.

      Transitive pinning promotes every transitively-referenced package to a direct
      PackageReference, which for a packable project means it lands in the generated nuspec.
      The satellites would then declare Aspire.Hosting, LibGit2Sharp and YamlDotNet - core's
      private implementation details, two of which they never touch - as part of their own
      public contract, each one a floor imposed on consumers and a version to maintain here
      forever. It defaults to off; the comment exists because turning it on is a common
      recommendation aimed at applications, where nothing is published and the reasoning
      does not apply.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Added to every project by Directory.Build.props, so it belongs in the root file:
       src/Directory.Packages.props imports this one rather than repeating it. -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample AppHost is a consumer of the packages, so its Aspire version moves with the
         floors in src/Directory.Packages.props rather than on its own: mixing versions within
         the Aspire family is exactly what #89 was about.

         It has to be moved by hand, and this line is only half of it - `<Sdk Name=
         "Aspire.AppHost.Sdk" Version="..." />` in DemoAppHost.csproj carries the same version
         and has to move with it. .github/dependabot.yml ignores this id for that reason: an
         automated bump can only reach the half it can parse. ci.yml's `verify repo invariants`
         job fails the build if the two halves are not level. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
