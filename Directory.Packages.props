<Project>

  <!--
    Central Package Management: versions live here, PackageReference in the projects carries
    only the id. Without it the same version is repeated once per project - the xunit set is
    identical across all three test projects today.

    This file holds the versions for projects whose dependencies constrain nobody: the tests
    and the sample. The published package has its own file next to it, because a version there
    is a floor consumers inherit and the two roles want opposite policies. See
    src/Directory.Packages.props.

    The two guest-language hosting packages are the exception, and they are declared below
    rather than there. Core references them with PrivateAssets="all", so they are floors on
    nobody through the nuspec - but the kind test projects reference them for real, and those
    live under test/, which sees only this file. Declaring them in both places is NU1506,
    since src/Directory.Packages.props imports this one.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Off deliberately, and it must stay off while this repository publishes packages.

      Transitive pinning promotes every transitively-referenced package to a direct
      PackageReference, which for a packable project means it lands in the generated nuspec.
      Core would then declare its dependencies' dependencies as part of its own public
      contract, each one a floor imposed on every consumer and a version to maintain here
      forever. It defaults to off; the comment exists because turning it on is a common
      recommendation aimed at applications, where nothing is published and the reasoning
      does not apply.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Added to every project by Directory.Build.props, so it belongs in the root file:
       src/Directory.Packages.props imports this one rather than repeating it. -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample AppHost is a consumer of the packages, so its Aspire version moves with the
         floors in src/Directory.Packages.props rather than on its own: mixing versions within
         the Aspire family is exactly what #89 was about. Reading $(AspireVersion)
         (Directory.Build.props) is what makes that automatic rather than a literal someone has
         to remember, and it is what lets aspire-matrix.yml move this line with the floors it
         already overrides - as a literal, it stayed on 13.5.2 while those floated (#116).

         This is still only half of the AppHost's Aspire version. The other half is `<Sdk
         Name="Aspire.AppHost.Sdk" />` in DemoAppHost.csproj, whose version lives in global.json
         because neither Central Package Management nor an MSBuild property reaches an MSBuild
         SDK. That one does have to be moved by hand alongside $(AspireVersion);
         .github/dependabot.yml ignores this id for that reason, and ci.yml's `verify repo
         invariants` job fails if the two part. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Java" Version="13.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
