<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Not an Aspire integration, so it carries no [AspireExport] surface. Without this,
         Directory.Build.props' repo-wide EnableAspireIntegrationAnalyzers treats it as one
         anyway and ASPIREEXPORT017 (new in Aspire 13.5.0) fails the build. See #90. -->
    <IsAspirePolyglotCompatible>false</IsAspirePolyglotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aspire.Hosting.ServiceSources.JavaScript\Aspire.Hosting.ServiceSources.JavaScript.csproj" />
  </ItemGroup>

  <!-- AspireFamilyVersionCheckTests runs the MSBuild check the package ships, and a
       ProjectReference does not bring it along: NuGet imports it out of buildTransitive/ in the
       restored package, which is a path no project in this repo takes. Copying the real file to
       the test output is what keeps the test on the shipped one rather than a second copy that
       could drift from it. -->
  <ItemGroup>
    <None Include="..\..\src\Aspire.Hosting.ServiceSources.JavaScript\buildTransitive\KoalaSoft.Aspire.Hosting.ServiceSources.JavaScript.targets"
          Link="PackagedTargets\KoalaSoft.Aspire.Hosting.ServiceSources.JavaScript.targets"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
